<?xml version="1.0" encoding="utf-8"?>
<diff>
  <!-- Payout voice plays once (#29): bug fix 7 and the no-representative guard (spec #18, #17).
       Speaky stops instantiating, so each payout's thanks fires on the next line-279 only and
       finishes, instead of piling up across payouts. The thanks start_script is replaced by one
       inside a representative-exists check (in the actions, not a condition: a failed condition
       would wait for the next line-279 forever), so factions without a representative get the
       computer line and no thanks. The @ makes a null $FactionRep read as false instead of an
       error. A diff can't wrap an existing node in a new one, so the start_script is written here
       (as the spec prescribes) and re-states Head Hunter's call: same object, script, line ids,
       delay and interactive values. -->
  <replace sel="//cue[@name='Speaky']/@instantiate">false</replace>
  <remove sel="//cue[@name='Speaky']/actions/start_script"/>
  <!-- hh-copy: a diff can't wrap Head Hunter's existing start_script in the new do_if, so it is re-stated inside it -->
  <add sel="//cue[@name='Speaky']/actions">
    <do_if value="@$FactionRep.exists">
      <start_script object="$FactionRep" name="'player.interaction'">
        <param name="Line" value="[2013, 2111, 5023].random"/>
        <param name="MaxQueueDelay" value="10s"/>
        <param name="interactive" value="false"/>
      </start_script>
    </do_if>
  </add>

  <!-- Classic Baddies on SWI (#27, spec #18, #10; bug fix 3). Add only: every vanilla id stays.
       With the option on, killers owned by SWI's baddies (sith, huttpirates, mandoraiders,
       valarian, blacksun; xenon = Unknown Threat and khaak = Yuuzhan Vong already there) get
       wanted bounties: the board entry, then the $HHAllWanted add. -->
  <replace sel="//cue[@name='WantedDestructionTracker']/actions/do_else/do_elseif/@value">global.$HeadHunterClassicBaddies and ($killer.trueowner == faction.xenon or $killer.trueowner == faction.khaak or $killer.trueowner == faction.scaleplate or $killer.trueowner == faction.buccaneers or $killer.trueowner == faction.sith or $killer.trueowner == faction.huttpirates or $killer.trueowner == faction.mandoraiders or $killer.trueowner == faction.valarian or $killer.trueowner == faction.blacksun)</replace>
  <replace sel="//cue[@name='WantedDestructionTracker']/actions/do_elseif/@value">global.$HeadHunterClassicBaddies and ($killer.trueowner == faction.xenon or $killer.trueowner == faction.khaak or $killer.trueowner == faction.scaleplate or $killer.trueowner == faction.buccaneers or $killer.trueowner == faction.sith or $killer.trueowner == faction.huttpirates or $killer.trueowner == faction.mandoraiders or $killer.trueowner == faction.valarian or $killer.trueowner == faction.blacksun)</replace>
  <!-- Bug fix 3: with the option on, the player's ships never join $HHAllPlayerWanted, so no
       hunters are sent after them (the same guard the $HHAllWanted add has) -->
  <replace sel="//cue[@name='WantedDestructionTracker']/actions/do_if[@value='$killer.isplayerowned and not global.$HHAllPlayerWanted.indexof.{$killer}']/@value">not global.$HeadHunterClassicBaddies and $killer.isplayerowned and not global.$HHAllPlayerWanted.indexof.{$killer}</replace>
  <!-- "Never posts a bounty" victim lists: killing SWI's baddies never makes the killer wanted,
       option on or off. The ship list PapaCue fills, and the handler that adds new ships to it. -->
  <replace sel="//cue[@name='PapaCue']/actions/find_ship[@groupname='global.$HHAllShips']/match[@trueowner]/@trueowner">[faction.buccaneers,faction.civilian,faction.criminal,faction.khaak,faction.ownerless,faction.player,faction.scaleplate,faction.yaki,faction.xenon,faction.visitor,faction.sith,faction.huttpirates,faction.mandoraiders,faction.valarian,faction.blacksun]</replace>
  <replace sel="//cue[@name='AllShipsHandler']/conditions/check_all/check_object/@owner">[faction.buccaneers,faction.civilian,faction.criminal,faction.khaak,faction.ownerless,faction.player,faction.scaleplate,faction.yaki,faction.xenon,faction.visitor,faction.sith,faction.huttpirates,faction.mandoraiders,faction.valarian,faction.blacksun]</replace>
  <!-- /Classic Baddies on SWI (#27) -->

  <!-- S/M capture pays (#28, spec #18 bug fixes 1 and 2). Head Hunter's SCapturedHandler computes
       the reward of a bailed (abandoned) wanted S/M ship but never transfers it. These ops pay it,
       credits only, when a player-owned ship hit the wanted ship in the last 60 s (the stamp
       written by the patch's own cue HH_SWI_Patch.Stamp_Player_Hit, md/hh_swi_patch.xml), and
       never for a ship that was player-owned. Otherwise the bail clears the bounty unpaid, as Head
       Hunter already does. -->
  <!-- Read the stamp while the wanted entry still exists (the handler removes it next) -->
  <add sel="//cue[@name='SCapturedHandler']/actions/set_value[@name='$lastfaction']" pos="after">
    <set_value name="$hhswiPlayerHit" exact="@global.$HeadHunterWantedTracker.{event.object}.$hhswiplayerhit"/>
    <set_value name="$hhswiPaid" exact="false"/>
  </add>
  <!-- Pay before the payout voice, as the destroy claim does -->
  <add sel="//cue[@name='SCapturedHandler']/actions/signal_cue_instantly[@cue='PayoutEffect']" pos="before">
    <do_if value="$hhswiPlayerHit != null and player.age lt $hhswiPlayerHit + 60s and not event.object.isplayerowned and not @global.$HHAllPlayerWanted.indexof.{event.object} and @$rewardCr gt 0Cr">
      <transfer_money from="faction.civilian" to="faction.player" amount="$rewardCr"/>
      <set_value name="$hhswiPaid" exact="true"/>
    </do_if>
  </add>
  <!-- /S/M capture pays (#28) -->
  <!-- Hunt lifecycle (#26), spec #18 bug fix 5: language-proof drone checks. Head Hunter tests
       a killer or claimer for a drone with typename == 'Drone', the ship type's display name, so
       it only works in English. isunit (vanilla's own test for a carried drone, e.g.
       aiscripts/lib.recall.subordinates.xml) doesn't depend on the language. The other two are in
       aiscripts/headhunter.assassinate.xml. -->
  <replace sel="//cue[@name='WantedDestructionTracker']/actions/do_if[@value=&quot;event.param.typename == 'Drone'&quot;]/@value">event.param.isunit</replace>
  <replace sel="//cue[@name='WantedClaimTracker']/actions/do_if[@value=&quot;event.param.typename == 'Drone'&quot;]/@value">event.param.isunit</replace>
  <!-- /Hunt lifecycle (#26) -->
</diff>
